# Supervisor HTTP
PORT=3000
HOST=127.0.0.1
TENANTS_FILE=./config/tenants.json
DATA_DIR=./data

# Meta / WhatsApp Cloud API
# Required only when at least one tenant uses whatsapp.mode=cloud
META_WEBHOOK_VERIFY_TOKEN=replace-with-random-verify-token
META_APP_SECRET=replace-with-meta-app-secret
META_GRAPH_VERSION=replace-with-current-graph-version
DEMO_META_ACCESS_TOKEN=replace-with-whatsapp-cloud-api-token

# AI provider example
DEMO_OPENAI_API_KEY=replace-with-openai-api-key

# Linked-device transport
# Required when at least one tenant uses whatsapp.mode=linked-device
LINKED_DEVICE_INGRESS_TOKEN=replace-with-random-ingress-token
WHATSAPP_LINKED_DEVICE_WORKER_TOKEN=replace-with-random-worker-token
# Optional runtime override. Useful because native local uses 127.0.0.1 while Compose uses the service hostname.
LINKED_DEVICE_WORKER_URL_OVERRIDE=
WHATSAPP_WEB_WORKER_HOST=127.0.0.1
WHATSAPP_WEB_WORKER_PORT=7441
WHATSAPP_WEB_DATA_DIR=./data/whatsapp-web
SUPERVISOR_INTERNAL_URL=http://127.0.0.1:3000
WHATSAPP_WEB_SPOOL_FLUSH_MS=5000
WHATSAPP_WEB_MIN_SEND_INTERVAL_MS=350
WHATSAPP_WEB_MAX_SEND_QUEUE=100

# Browser action capability
# BROWSER_RUNTIME: none | agent-browser | remote
BROWSER_RUNTIME=none
BROWSER_COMMAND=agent-browser
# BROWSER_ENGINE: chrome | lightpanda
BROWSER_ENGINE=chrome
BROWSER_WORKER_URL=http://127.0.0.1:7331
BROWSER_WORKER_TOKEN=
BROWSER_REQUIRED=false
BROWSER_TASK_TIMEOUT_MS=60000

# Standalone browser worker
BROWSER_WORKER_HOST=127.0.0.1
BROWSER_WORKER_PORT=7331
BROWSER_WORKER_RUNTIME=agent-browser
BROWSER_WORKER_MAX_CONCURRENCY=2

# Docker host binding. Keep 127.0.0.1 when a reverse proxy handles TLS.
WAS_BIND_ADDRESS=127.0.0.1
WAS_PORT=3000
WAS_DOMAIN=whatsapp.example.com
