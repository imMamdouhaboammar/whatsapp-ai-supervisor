[
  {
    "id": "demo-linked-business",
    "shadowMode": true,
    "businessContext": {
      "name": "Demo Linked Business",
      "language": "Arabic and English",
      "facts": [
        "Working hours are 9:00 to 17:00 Sunday through Thursday",
        "Never invent prices, discounts, delivery dates, or refund approvals"
      ]
    },
    "whatsapp": {
      "mode": "linked-device",
      "sessionId": "demo-linked-business",
      "workerUrl": "http://127.0.0.1:7441",
      "workerTokenEnv": "WHATSAPP_LINKED_DEVICE_WORKER_TOKEN",
      "pairingPhoneNumber": "201000000000",
      "allowGroups": false
    },
    "ai": {
      "apiKeyEnv": "DEMO_OPENAI_API_KEY",
      "route": "standard",
      "routes": {
        "standard": [
          { "provider": "openai", "model": "gpt-5.6" }
        ]
      }
    },
    "policy": {
      "minConfidence": 0.82,
      "defaultAction": "human",
      "rules": [
        { "id": "faq-auto", "intent": "faq", "action": "reply" },
        { "id": "hours-auto", "intent": "working_hours", "action": "reply" },
        { "id": "pricing-draft", "intent": "pricing", "action": "draft" },
        { "id": "complaint-human", "intent": "complaint", "action": "human" }
      ]
    }
  }
]
